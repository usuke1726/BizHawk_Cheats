{
    "BizHawkServer.alwaysShowStatus": false,
    "BizHawkServer.autoListen": false,
    "BizHawkServer.autoClose": false,
    "BizHawkServer.port": 8099,
    "BizHawkServer.stopCommand": [
        "RST:"
    ],
    "[lua]": {
        "editor.colorDecorators": false,
        "editor.defaultColorDecorators": "never"
    },
    "notebook.lineNumbers": "on",
    "BizHawkServer.IBizNotebookTemplates": [
        [
            "---@meta",
            "file:./.lib/for_ibiz/path.d.txt",
            "file:./.lib/for_ibiz/mem.d.txt",
            "file:./.lib/for_ibiz/util.d.txt",
            "file:./.lib/for_ibiz/array.d.txt",
            "file:./.lib/for_ibiz/sjis.d.txt",
            "file:./.lib/for_ibiz/timer.d.txt",
            "file:./.lib/for_ibiz/irume.d.txt",
            "file:./.lib/for_ibiz/ds_button.d.txt",
            "file:./.lib/for_ibiz/recording.d.txt",
            "file:./.lib/for_ibiz/image.d.txt",
            "file:./.lib/for_ibiz/asm.d.txt",
            "file:./.lib/for_ibiz/actions.d.txt",
            "file:./.lib/for_ibiz/Nitro.d.txt",
            "file:./.lib/for_ibiz/lib.d.txt",
        ],
        ""
    ],
    "Lua.runtime.version": "Lua 5.4",
    "Lua.diagnostics.disable": [
        "lowercase-global"
    ]
}